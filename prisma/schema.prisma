// Prisma schema — 生产使用 Vercel Neo（PostgreSQL）
// Prisma 7: 连接 URL 写在 prisma.config.ts，Client 用 adapter

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// 本站用户（用户名 + 密码 + 邮箱验证码注册）
model User {
  id           String   @id @default(cuid())
  /// 统一为 email
  provider     String   @default("email")
  /// 唯一业务键：email:<addr>
  providerKey  String   @unique
  email        String   @unique
  username     String   @unique
  /// 密码 scrypt 哈希（salt:hash）
  passwordHash String
  displayName  String?
  avatarUrl    String?
  /// 剩余生图次数
  credits      Int      @default(20)
  /// 是否管理员
  isAdmin      Boolean  @default(false)
  /// 上次签到日期 YYYY-MM-DD（UTC+8）
  lastCheckIn  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  generations Generation[]
}

/// 邮箱验证码
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, code])
}

/// 生图 / 编辑历史（图片存 Vercel Blob，数据库只存 URL）
model Generation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// generation | edit
  mode      String
  prompt    String
  /// Vercel Blob 公开访问 URL
  imageUrl  String
  /// 生成时使用的模型显示名（快照，模型删除后仍保留）
  modelName String?
  seed      Int?
  cfgScale  Float?
  steps     Int?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

/// 生图模型配置（管理员在界面维护，密钥仅存服务端）
model ImageModel {
  id        String   @id @default(cuid())
  /// 显示名，如 "Grok 图像"
  name      String   @unique
  /// 适配器类型：stepfun | openai | gemini
  provider  String
  /// 模型标识，如 grok-2-image / gpt-image-1 / gemini-2.5-flash-image
  model     String
  /// API 根地址
  baseUrl   String
  /// API 密钥（绝不返回给前端）
  apiKey    String
  enabled   Boolean  @default(true)
  /// 是否为默认模型（全局最多一个）
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
